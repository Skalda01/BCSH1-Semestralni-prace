<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SkalaView.ViewModels"
             x:Class="SkalaView.AppComponent.ChartMenu.ChartMenu"
             x:DataType="vm:CandlestickChartViewModel">

    <Border Background="#0B1220"
            BorderBrush="#1F2937"
            BorderThickness="1"
            CornerRadius="14"
            Padding="10">
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="2,0,2,8">
                <StackPanel Spacing="1">
                    <TextBlock Text="Candlestick Chart"
                               Foreground="#F8FAFC"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Right click: pan | Wheel: zoom | Double click: reset"
                               Foreground="#94A3B8"
                               FontSize="10.5"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#111827"
                        BorderBrush="#1F2937"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="OHLC"
                               Foreground="#93C5FD"
                               FontSize="10.5"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Border x:Name="Chart"
                        Background="#0B1220"
                        ClipToBounds="True">
                    <Canvas x:Name="CandleCanvas"/>
                </Border>

                <TextBlock Text="{Binding LoadStatus}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#94A3B8"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="420"/>

                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                    <Border x:Name="CrossVertical"
                            IsVisible="False"
                            Width="1"
                            Height="0"
                            Background="#99CBD5E1"/>
                    <Border x:Name="CrossHorizontal"
                            IsVisible="False"
                            Width="0"
                            Height="1"
                            Background="#99CBD5E1"/>
                </Canvas>

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,10"
                        Padding="10,7"
                        CornerRadius="8"
                        Background="#D9111827"
                        BorderBrush="#334155"
                        BorderThickness="1">
                    <TextBlock x:Name="CrossInfoText"
                               Foreground="#E2E8F0"
                               FontSize="11.5"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
