<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:api="using:SkalaView.ApiService"
             xmlns:vm="using:SkalaView.ViewModels"
             x:Class="SkalaView.AppComponent.OrderBook.OrderBook"
             x:DataType="vm:OrderBookViewModel">

    <Border CornerRadius="20"
            Background="#111827"
            BorderBrush="#1F2937"
            BorderThickness="1"
            Padding="12">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SymbolText}"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#94A3B8"
                               FontSize="10.5"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#0B1220"
                        BorderBrush="#1F2937"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding SpreadText}"
                               Foreground="#7DD3FC"
                               FontSize="10.5"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
                <TextBlock Text="Price"
                           Foreground="#64748B"
                           FontSize="10"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1"
                           Text="Qty"
                           Foreground="#64748B"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextAlignment="Right"/>
                <TextBlock Grid.Column="2"
                           Text="Total"
                           Foreground="#64748B"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextAlignment="Right"/>
            </Grid>

            <Grid Grid.Row="2"
                  RowDefinitions="*,Auto,*"
                  RowSpacing="8">
                <ItemsControl ItemsSource="{Binding Asks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="api:OrderBookLevel">
                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="8"
                                  Margin="0,0,0,3">
                                <TextBlock Text="{Binding PriceText}"
                                           Foreground="#F87171"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding QuantityText}"
                                           Foreground="#CBD5E1"
                                           FontSize="10.5"
                                           TextAlignment="Right"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TotalText}"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1"
                        Background="#0B1220"
                        BorderBrush="#1F2937"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,5">
                    <TextBlock Text="{Binding SpreadText}"
                               Foreground="#E5E7EB"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>

                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding Bids}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="api:OrderBookLevel">
                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="8"
                                  Margin="0,0,0,3">
                                <TextBlock Text="{Binding PriceText}"
                                           Foreground="#34D399"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding QuantityText}"
                                           Foreground="#CBD5E1"
                                           FontSize="10.5"
                                           TextAlignment="Right"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TotalText}"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
